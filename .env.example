# Настройки локального Redash. Замените значения перед первым запуском.
# Случайные секреты можно получить командой: openssl rand -hex 32
# Настоящий .env игнорируется Git.
POSTGRES_PASSWORD=replace_with_random_local_password
POSTGRES_PORT=55435
REDASH_PORT=5055
REDASH_COOKIE_SECRET=replace_with_random_cookie_secret
REDASH_SECRET_KEY=replace_with_random_encryption_secret
REDASH_URL=http://127.0.0.1:5055

# Для scripts/load_postgres.py. Пароль в DATABASE_URL совпадает с POSTGRES_PASSWORD.
DATABASE_URL=postgresql://redash:replace_with_random_local_password@127.0.0.1:55435/redash
REDASH_PG_USER=sms_ab_reader
REDASH_PG_PASSWORD=replace_with_random_reader_password
